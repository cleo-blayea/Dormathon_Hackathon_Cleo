    </Box>
  </Box>

  {/* Footer */}
  <Box style={{ position: 'absolute', bottom: 32, left: 60, right: 60, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 12, color: '#64748B' }}>DORMATHON 2026 · Track 2: Agentic Solutions</Text>
