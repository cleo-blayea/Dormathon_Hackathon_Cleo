<Slide style={{ width: '1280px', height: '720px', padding: 0, background: '#F8FAFC' }}>
  {/* Top accent bar */}
  <Box style={{ position: 'absolute', top: 0, left: 0, width: '1280px', height: 6, background: 'linear-gradient(90deg, #0B1E3F 0%, #2563EB 100%)' }} />

  {/* Section tag */}
  <Box style={{ position: 'absolute', top: 32, left: 60, padding: '4px 12px', borderRadius: 4, background: '#0B1E3F' }}>
    <Text style={{ fontSize: 11, color: '#FFFFFF', fontWeight: 700, letterSpacing: 1.5 }}>02 / BUSINESS PROBLEM</Text>
  </Box>

  {/* Title */}
  <Box style={{ position: 'absolute', top: 64, left: 60, width: 1160 }}>
    <Text style={{ fontSize: 30, color: '#0B1E3F', fontWeight: 700, lineHeight: 1.2 }}>
      A dark building is the first sign of trouble
    </Text>
  </Box>

  {/* Hero illustration card - small supermarket scenario */}
  <Box style={{ position: 'absolute', top: 140, left: 60, width: 360, height: 250, borderRadius: 12, background: '#0B1E3F', padding: 20 }}>
    <Text style={{ fontSize: 11, color: '#06B6D4', fontWeight: 700, letterSpacing: 1.5, marginBottom: 8 }}>ILLUSTRATIVE SCENARIO</Text>
    <Text style={{ fontSize: 20, color: '#FFFFFF', fontWeight: 700, marginBottom: 12 }}>Neighborhood Supermarket</Text>
    <Text style={{ fontSize: 13, color: '#CBD5E1', lineHeight: 1.5 }}>
      A 250 m² store with two refrigerator cases, six freezer units, and a small backup generator in the back.
      <br /><br />
      <Text style={{ color: '#F59E0B', fontWeight: 700 }}>No on-site electrician.</Text> Visual inspections every quarter. ATS assumed to work.
    </Text>
  </Box>

  {/* Right side - three failure modes */}
  <Box style={{ position: 'absolute', top: 140, left: 440, width: 780 }}>
    <Text style={{ fontSize: 16, color: '#0B1E3F', fontWeight: 700, marginBottom: 12 }}>What can go wrong between quarterly inspections?</Text>

    <Box style={{ flexDirection: 'column', gap: 12 }}>
      {/* Card 1 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', padding: 14, borderRadius: 8, background: '#FFFFFF', border: '1px solid #E2E8F0' }}>
        <Box style={{ width: 44, height: 44, borderRadius: 22, background: '#FEE2E2', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 20, fontWeight: 800, color: '#EF4444' }}>!</Text>
        </Box>
        <Box style={{ marginLeft: 16, flex: 1 }}>
          <Text style={{ fontSize: 16, color: '#0F172A', fontWeight: 700 }}>Generator fails to start</Text>
          <Text style={{ fontSize: 13, color: '#64748B', marginTop: 2 }}>Battery, fuel, or controller fault. Discovered only during the outage.</Text>
        </Box>
      </Box>

      {/* Card 2 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', padding: 14, borderRadius: 8, background: '#FFFFFF', border: '1px solid #E2E8F0' }}>
        <Box style={{ width: 44, height: 44, borderRadius: 22, background: '#FEF3C7', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 20, fontWeight: 800, color: '#F59E0B' }}>→</Text>
        </Box>
        <Box style={{ marginLeft: 16, flex: 1 }}>
          <Text style={{ fontSize: 16, color: '#0F172A', fontWeight: 700 }}>Generator starts but ATS does not transfer</Text>
          <Text style={{ fontSize: 13, color: '#64748B', marginTop: 2 }}>Contactor or sensor fault. Generator runs but the building stays dark.</Text>
        </Box>
      </Box>

      {/* Card 3 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', padding: 14, borderRadius: 8, background: '#FFFFFF', border: '1px solid #E2E8F0' }}>
        <Box style={{ width: 44, height: 44, borderRadius: 22, background: '#DBEAFE', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 20, fontWeight: 800, color: '#2563EB' }}>~</Text>
        </Box>
        <Box style={{ marginLeft: 16, flex: 1 }}>
          <Text style={{ fontSize: 16, color: '#0F172A', fontWeight: 700 }}>Generator overheats under sustained load</Text>
          <Text style={{ fontSize: 13, color: '#64748B', marginTop: 2 }}>Marginal cooling capacity. Shuts down mid-outage.</Text>
        </Box>
      </Box>
    </Box>
  </Box>

  {/* Bottom pain points strip */}
  <Box style={{ position: 'absolute', bottom: 110, left: 60, right: 60, padding: 18, borderRadius: 12, background: '#0B1E3F' }}>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
      <Box style={{ flex: 1 }}>
        <Text style={{ fontSize: 11, color: '#06B6D4', fontWeight: 700, letterSpacing: 1.5, marginBottom: 4 }}>THE GAP</Text>
        <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 700, lineHeight: 1.4 }}>
          SMEs have generators. They don't have engineers to interpret what the telemetry is telling them.
        </Text>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 32, marginLeft: 24 }}>
        <Box style={{ alignItems: 'center' }}>
          <Text style={{ fontSize: 28, color: '#06B6D4', fontWeight: 800, lineHeight: 1 }}>0</Text>
          <Text style={{ fontSize: 11, color: '#94A3B8', marginTop: 4 }}>Telemetry reviews</Text>
        </Box>
        <Box style={{ alignItems: 'center' }}>
          <Text style={{ fontSize: 28, color: '#06B6D4', fontWeight: 800, lineHeight: 1 }}>0</Text>
          <Text style={{ fontSize: 11, color: '#94A3B8', marginTop: 4 }}>ATS load tests</Text>
        </Box>
      </Box>
    </Box>
  </Box>

  {/* Footer */}
  <Box style={{ position: 'absolute', bottom: 32, left: 60, right: 60, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 12, color: '#64748B' }}>GenBuddy · DORMATHON 2026 · Track 2: Agentic Solutions</Text>
    <Text style={{ fontSize: 12, color: '#64748B' }}>02 / 10</Text>
  </Box>
</Slide>