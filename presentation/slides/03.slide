      GenBuddy turns raw signals into readiness and action
    </Text>
  </Box>

  {/* Three-step horizontal flow */}
  <Box style={{ position: 'absolute', top: 140, left: 60, right: 60, flexDirection: 'row', alignItems: 'stretch', gap: 16 }}>
    {/* Step 1 - INPUTS */}
    <Box style={{ flex: 1, padding: 20, borderRadius: 12, background: '#FFFFFF', border: '1px solid #E2E8F0' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', marginBottom: 16 }}>
        <Box style={{ width: 32, height: 32, borderRadius: 16, background: '#0B1E3F', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 700 }}>1</Text>
        </Box>
        <Text style={{ fontSize: 11, color: '#06B6D4', fontWeight: 700, letterSpacing: 1.5, marginLeft: 12 }}>INPUTS</Text>
      </Box>
      <Text style={{ fontSize: 18, color: '#0F172A', fontWeight: 700, marginBottom: 12 }}>Existing generator data</Text>
      <Box style={{ flexDirection: 'column', gap: 8 }}>
        <Text style={{ fontSize: 13, color: '#475569' }}>
          <span style={{ color: '#2563EB', fontWeight: 700 }}>·</span> Telemetry (176 records, 13 params)
        </Text>
        <Text style={{ fontSize: 13, color: '#475569' }}>
          <span style={{ color: '#2563EB', fontWeight: 700 }}>·</span> ATS event log (176 records)
        </Text>
        <Text style={{ fontSize: 13, color: '#475569' }}>
          <span style={{ color: '#2563EB', fontWeight: 700 }}>·</span> Maintenance history (4 records)
        </Text>
      </Box>
    </Box>

    {/* Arrow 1 */}
    <Box style={{ width: 32, alignItems: 'center', justifyContent: 'center' }}>
      <Text style={{ fontSize: 32, color: '#2563EB', fontWeight: 700 }}>→</Text>
    </Box>

    {/* Step 2 - GENBUDDY AI */}
    <Box style={{ flex: 1.3, padding: 20, borderRadius: 12, background: 'linear-gradient(135deg, #0B1E3F 0%, #1E40AF 100%)' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', marginBottom: 16 }}>
        <Box style={{ width: 32, height: 32, borderRadius: 16, background: '#06B6D4', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 14, color: '#0B1E3F', fontWeight: 700 }}>2</Text>
        </Box>
        <Text style={{ fontSize: 11, color: '#06B6D4', fontWeight: 700, letterSpacing: 1.5, marginLeft: 12 }}>AI INVESTIGATION</Text>
      </Box>
      <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 700, marginBottom: 12 }}>WorkBuddy LLM agent</Text>
      <Box style={{ flexDirection: 'column', gap: 6 }}>
        <Text style={{ fontSize: 13, color: '#CBD5E1' }}>
          <span style={{ color: '#06B6D4', fontWeight: 700 }}>·</span> Plans a multi-step investigation
        </Text>
        <Text style={{ fontSize: 13, color: '#CBD5E1' }}>
          <span style={{ color: '#06B6D4', fontWeight: 700 }}>·</span> Runs engineering tools
        </Text>
        <Text style={{ fontSize: 13, color: '#CBD5E1' }}>
          <span style={{ color: '#06B6D4', fontWeight: 700 }}>·</span> Reads raw data independently
        </Text>
        <Text style={{ fontSize: 13, color: '#CBD5E1' }}>
          <span style={{ color: '#06B6D4', fontWeight: 700 }}>·</span> Reasons about uncertainties
