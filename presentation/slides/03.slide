    </Box>
  </Box>

  {/* Key benefit statement */}
  <Box style={{ position: 'absolute', bottom: 110, left: 60, right: 60, padding: 18, borderRadius: 12, background: '#FFFFFF', border: '1px solid #E2E8F0', borderLeft: '4px solid #06B6D4' }}>
    <Text style={{ fontSize: 14, color: '#94A3B8', fontWeight: 700, letterSpacing: 1.5, marginBottom: 6 }}>BUSINESS OUTCOME</Text>
