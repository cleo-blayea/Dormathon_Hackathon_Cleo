<Slide style={{ width: '1280px', height: '720px', padding: 0, background: '#F8FAFC' }}>
  {/* Top accent bar */}
  <Box style={{ position: 'absolute', top: 0, left: 0, width: '1280px', height: 6, background: 'linear-gradient(90deg, #0B1E3F 0%, #2563EB 100%)' }} />

  {/* Section tag */}
  <Box style={{ position: 'absolute', top: 28, left: 60, padding: '4px 12px', borderRadius: 4, background: '#0B1E3F' }}>
    <Text style={{ fontSize: 11, color: '#FFFFFF', fontWeight: 700, letterSpacing: 1.5 }}>08 / DYNAMIC AI PLANNING</Text>
  </Box>

  {/* Title */}
  <Box style={{ position: 'absolute', top: 64, left: 60, width: 1160 }}>
    <Text style={{ fontSize: 28, color: '#0B1E3F', fontWeight: 700, lineHeight: 1.2 }}>
      The agent did NOT reuse the same plan for both investigations
    </Text>
  </Box>

  {/* Two side-by-side panels */}
  <Box style={{ position: 'absolute', top: 134, left: 60, right: 60, flexDirection: 'row', gap: 16 }}>
    {/* LEFT - Investigation 1 */}
    <Box style={{ flex: 1, padding: 16, borderRadius: 12, background: '#FFFFFF', border: '1px solid #E2E8F0', borderLeft: '6px solid #06B6D4' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', marginBottom: 12 }}>
        <Box style={{ width: 36, height: 36, borderRadius: 18, background: '#06B6D4', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 16, color: '#0B1E3F', fontWeight: 800 }}>1</Text>
        </Box>
        <Box style={{ marginLeft: 10 }}>
          <Text style={{ fontSize: 11, color: '#06B6D4', fontWeight: 700, letterSpacing: 1 }}>INVESTIGATION 1</Text>
          <Text style={{ fontSize: 16, color: '#0F172A', fontWeight: 700 }}>Readiness Assessment</Text>
        </Box>
      </Box>

      <Text style={{ fontSize: 12, color: '#64748B', fontStyle: 'italic', marginBottom: 14, lineHeight: 1.4 }}>
        "Is my backup generator ready for the next power outage?"
      </Text>

      <Box style={{ flexDirection: 'column', gap: 7 }}>
        {[
          { label: 'Question type', value: 'Forward-looking' },
          { label: 'Planned steps', value: '13 steps' },
          { label: 'Data scope', value: 'All 356 records, 3 scenarios' },
          { label: 'Tools', value: 'Scripts + API + direct CSV reads' },
          { label: 'Analysis method', value: 'Cross-scenario comparison' },
          { label: 'Deliverable', value: 'Prioritized work orders' },
          { label: 'Maintenance angle', value: '"Was it serviced recently?"' },
        ].map((row, i) => (
          <Box key={i} style={{ flexDirection: 'row', paddingBottom: 5 }}>
            <Text style={{ fontSize: 11, color: '#94A3B8', width: 130, fontWeight: 600 }}>{row.label}</Text>
            <Text style={{ fontSize: 11, color: '#0F172A', fontWeight: 600, flex: 1 }}>{row.value}</Text>
          </Box>
        ))}
      </Box>

      <Box style={{ marginTop: 12, padding: 8, borderRadius: 6, background: '#F0F9FF' }}>
        <Text style={{ fontSize: 11, color: '#0E7490', fontWeight: 700 }}>
          Key finding: 9.8 percentage points more rated loading → 22.8°C higher temperature
        </Text>
      </Box>
    </Box>

    {/* RIGHT - Investigation 2 */}
    <Box style={{ flex: 1, padding: 16, borderRadius: 12, background: '#FFFFFF', border: '1px solid #E2E8F0', borderLeft: '6px solid #2563EB' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', marginBottom: 12 }}>
        <Box style={{ width: 36, height: 36, borderRadius: 18, background: '#2563EB', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 800 }}>2</Text>
        </Box>
        <Box style={{ marginLeft: 10 }}>
          <Text style={{ fontSize: 11, color: '#2563EB', fontWeight: 700, letterSpacing: 1 }}>INVESTIGATION 2</Text>
          <Text style={{ fontSize: 16, color: '#0F172A', fontWeight: 700 }}>Root Cause Analysis</Text>
        </Box>
      </Box>

      <Text style={{ fontSize: 12, color: '#64748B', fontStyle: 'italic', marginBottom: 14, lineHeight: 1.4 }}>
        "Why did my generator shut down during last week's outage?"
      </Text>

      <Box style={{ flexDirection: 'column', gap: 7 }}>
        {[
          { label: 'Question type', value: 'Backward-looking' },
          { label: 'Planned steps', value: '8 steps (simplified)' },
          { label: 'Data scope', value: '92 records, failure window only' },
          { label: 'Tools', value: 'Scripts + direct CSV reads (no API)' },
          { label: 'Analysis method', value: 'Timeline reconstruction' },
          { label: 'Deliverable', value: 'Contractor briefing' },
          { label: 'Maintenance angle', value: '"Was the service adequate?"' },
        ].map((row, i) => (
          <Box key={i} style={{ flexDirection: 'row', paddingBottom: 5 }}>
            <Text style={{ fontSize: 11, color: '#94A3B8', width: 130, fontWeight: 600 }}>{row.label}</Text>
            <Text style={{ fontSize: 11, color: '#0F172A', fontWeight: 600, flex: 1 }}>{row.value}</Text>
          </Box>
        ))}
      </Box>

      <Box style={{ marginTop: 12, padding: 8, borderRadius: 6, background: '#EFF6FF' }}>
        <Text style={{ fontSize: 11, color: '#1E40AF', fontWeight: 700 }}>
          Key finding: 0A current + 11 transfers = unsuccessful transfer
        </Text>
      </Box>
    </Box>
  </Box>

  {/* Bottom highlight - what changed */}
  <Box style={{ position: 'absolute', bottom: 70, left: 60, right: 60, padding: 12, borderRadius: 12, background: '#0B1E3F' }}>
    <Text style={{ fontSize: 11, color: '#06B6D4', fontWeight: 700, letterSpacing: 1.5, marginBottom: 8, textAlign: 'center' }}>WHAT CHANGED — 7 DIMENSIONS OF ADAPTATION</Text>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-around', alignItems: 'center' }}>
      <Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 700 }}>Plan count</Text>
      <Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 700 }}>Data scope</Text>
      <Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 700 }}>Tool choice</Text>
      <Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 700 }}>Method</Text>
      <Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 700 }}>Format</Text>
      <Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 700 }}>Audience</Text>
      <Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 700 }}>Question framing</Text>
    </Box>
  </Box>

  {/* Footer */}
  <Box style={{ position: 'absolute', bottom: 28, left: 60, right: 60, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 12, color: '#64748B' }}>GenBuddy · DORMATHON 2026 · Track 2: Agentic Solutions</Text>
    <Text style={{ fontSize: 12, color: '#64748B' }}>08 / 10</Text>
  </Box>
</Slide>