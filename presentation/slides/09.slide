  {/* Bottom honesty badge */}
  <Box style={{ position: 'absolute', bottom: 70, left: 60, right: 60, padding: 10, borderRadius: 10, background: '#0B1E3F', flexDirection: 'row', alignItems: 'center', justifyContent: 'center' }}>
