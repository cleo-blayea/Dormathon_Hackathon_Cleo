        {
          title: 'No validated real-world cost savings',
          desc: 'No customer case studies; no measured downtime reduction.',
        },
        {
          title: 'Manual WorkBuddy triggering',
          desc: 'User copies question from dashboard to WorkBuddy. No direct API.',
        },
        {
          title: 'Single-user, local runtime',
