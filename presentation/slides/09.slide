  </Box>

  {/* Title */}
  <Box style={{ position: 'absolute', top: 64, left: 60, width: 1160 }}>
    <Text style={{ fontSize: 28, color: '#0B1E3F', fontWeight: 700, lineHeight: 1.2 }}>
      What we proved — and what we didn't
    </Text>
  </Box>

  {/* LEFT - Value */}
  <Box style={{ position: 'absolute', top: 130, left: 60, width: 580, height: 470, padding: 16, borderRadius: 12, background: '#FFFFFF', border: '1px solid #E2E8F0', borderTop: '6px solid #10B981' }}>
    <Text style={{ fontSize: 11, color: '#10B981', fontWeight: 700, letterSpacing: 1.5, marginBottom: 8 }}>VERIFIED PROTOTYPE RESULTS</Text>
    <Text style={{ fontSize: 20, color: '#0F172A', fontWeight: 700, marginBottom: 16 }}>What GenBuddy could do</Text>

    <Box style={{ flexDirection: 'column', gap: 12 }}>
      {[
        {
          title: 'Translate telemetry into plain-English flags',
          desc: '"11 failed ATS transfers" + "0A load current" → flagged for specialist investigation.',
        },
        {
          title: 'Prioritize maintenance by business impact',
          desc: 'CRITICAL · HIGH · INFORMATIONAL tags based on actual failure modes.',
        },
        {
          title: 'Speak contractor fluently',
          desc: 'Generates plain-language briefings with specific check instructions.',
        },
        {
          title: 'Reason across scenarios',
          desc: 'Cross-scenario comparison that fixed-temperature scripts cannot do.',
        },
        {
          title: 'Self-correct during investigation',
          desc: 'Agent fixed a temperature rise rate error in 3 report files.',
        },
      ].map((v, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'flex-start' }}>
          <Box style={{ width: 24, height: 24, borderRadius: 12, background: '#D1FAE5', alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
            <Text style={{ fontSize: 14, color: '#059669', fontWeight: 700 }}>+</Text>
          </Box>
          <Box style={{ marginLeft: 12, flex: 1 }}>
            <Text style={{ fontSize: 13, color: '#0F172A', fontWeight: 700 }}>{v.title}</Text>
            <Text style={{ fontSize: 11, color: '#64748B', marginTop: 2, lineHeight: 1.4 }}>{v.desc}</Text>
          </Box>
        </Box>
      ))}
    </Box>
  </Box>

  {/* RIGHT - Limitations */}
  <Box style={{ position: 'absolute', top: 130, left: 660, width: 560, height: 470, padding: 16, borderRadius: 12, background: '#FFFFFF', border: '1px solid #E2E8F0', borderTop: '6px solid #F59E0B' }}>
    <Text style={{ fontSize: 11, color: '#F59E0B', fontWeight: 700, letterSpacing: 1.5, marginBottom: 8 }}>HONEST LIMITATIONS</Text>
    <Text style={{ fontSize: 20, color: '#0F172A', fontWeight: 700, marginBottom: 16 }}>What we did not prove</Text>

    <Box style={{ flexDirection: 'column', gap: 12 }}>
      {[
        {
          title: 'No physical equipment connection',
          desc: 'All data is simulated. DSE6120 thresholds are UNVERIFIED.',
