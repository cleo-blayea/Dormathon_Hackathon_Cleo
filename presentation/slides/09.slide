        {
          title: 'Open investigation topics remain',
          desc: 'DSE6120 thresholds · ambient temp · ATS manufacturer specs.',
        },
      ].map((v, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'flex-start' }}>
