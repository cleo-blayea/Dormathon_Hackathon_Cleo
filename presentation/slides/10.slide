        <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 700, marginBottom: 8 }}>{card.title}</Text>
        <Text style={{ fontSize: 12, color: '#CBD5E1', lineHeight: 1.5 }}>{card.desc}</Text>
      </Box>
