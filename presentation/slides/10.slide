  </Box>

  {/* Demo access block */}
  <Box style={{ position: 'absolute', top: 320, left: 60, right: 60, padding: 18, borderRadius: 12, background: 'rgba(6,182,212,0.08)', border: '1px solid rgba(6,182,212,0.3)' }}>
